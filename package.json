{
  "name": "homebridge-stream-triggers",
  "displayName": "Homebridge Stream Triggers",
  "version": "1.3.0",
  "description": "HomeKit switches that launch live streams (YouTube/Twitch/Kick) on an Apple TV via atvremote and yt-dlp.",
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "apple-tv",
    "youtube",
    "twitch",
    "livestream",
    "homeautomation"
  ],
  "bugs": {
    "url": "https://github.com/micthiesen/homebridge-stream-triggers/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micthiesen/homebridge-stream-triggers.git"
  },
  "type": "module",
  "license": "MIT",
  "author": "Michael Thiesen",
  "main": "lib/index.js",
  "files": [
    "config.schema.json",
    "lib"
  ],
  "scripts": {
    "prebuild": "pnpm run clean",
    "build": "tsc --project tsconfig.source.json",
    "clean": "rm -rf lib/",
    "check:write": "oxlint --fix --report-unused-disable-directives . && oxfmt --write .",
    "format": "oxfmt --check .",
    "lint": "oxlint --report-unused-disable-directives .",
    "typecheck": "tsc --noEmit",
    "start": "homebridge -D --plugin-path .",
    "pretest": "pnpm run check && pnpm run typecheck",
    "test": "pnpm run test:only",
    "test:only": "vitest run",
    "format:write": "oxfmt --write .",
    "check": "pnpm run lint && pnpm run format"
  },
  "dependencies": {
    "@micthiesen/mitools": "^2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "hap-nodejs": "~0.14.3",
    "homebridge": "~2.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "oxlint": "1.80.0",
    "oxfmt": "0.65.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": ">=18"
  }
}
